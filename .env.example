SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Server-only secrets — never commit real values.
SUPABASE_SERVICE_ROLE_KEY=
CREDENCIAIS_CIFRA_CHAVE=

# Convite de empresas (Resend) — obrigatório para /admin enviar e-mail de acesso.
RESEND_API_KEY=
# EMAIL_REMETENTE é opcional (o código já tem um remetente padrão). Se for
# definir, o valor não pode ter espaço/"<"/">" sem aspas — o deploy.sh faz
# `. ./.env` (lê como shell script) antes do docker build, então um valor com
# espaço quebra o deploy inteiro com "Syntax error: newline unexpected". Não
# vale a pena arriscar: docker run --env-file também não remove aspas, então
# colocar o valor entre aspas troca um problema por outro. Deixe em branco.
